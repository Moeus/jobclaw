# Copy to .env and fill in your own values. Do not commit secrets.

# Search every keyword separately; commas separate terms (not words inside a term).
SEARCH_QUERIES=agent开发实习生,LLM应用实习生
RESUME_PATH=C:/resumes/me.md

# OpenAI-compatible Chat Completions. Defaults target Qwen/DashScope (Beijing).
# Use your region's matching API key and base URL.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus
JOBCLAW_REQUEST_TIMEOUT=30

# Browser and Boss search. 100010000 is the all-cities code in the provided URL.
JOBCLAW_HEADLESS=false
BOSS_CITY=100010000
# all = any type; 1901 = full-time; 1902 = internship; 1903 = part-time.
BOSS_JOB_TYPE=1902
# Persistent Chrome profile defaults to this project's .jobclaw/browser/boss.
# Set BOSS_BROWSER_USER_DATA_DIR to an absolute path only if overriding it.
BOSS_BROWSER_PORT=9334
# BOSS_BROWSER_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# Conservative cap on today's contact-button attempts (China time).
BOSS_DAILY_LIMIT=100
BOSS_APPLY_DELAY_MIN=5.0
BOSS_APPLY_DELAY_MAX=10.0

# Off: no salary filtering or separate structured salary field in the AI prompt.
# Set MIN_ANNUAL_SALARY for an optional CNY hard floor.
SALARY_FILTER_ENABLED=false
# MIN_ANNUAL_SALARY=120000

# Notification channels (configure any combination).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
